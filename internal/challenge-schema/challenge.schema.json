{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andriipancho/frontend-frenzy/challenge.schema.json",
  "title": "Frontend Frenzy challenge metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "domain",
    "topic",
    "difficulty",
    "topics",
    "estimatedMinutes",
    "prerequisites",
    "hints",
    "validation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{2,8}-[A-Z]{2,8}-[0-9]{3}$"
    },
    "title": { "type": "string", "minLength": 3 },
    "domain": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "topic": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "difficulty": {
      "enum": ["easy", "medium", "hard", "boss"]
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "estimatedMinutes": { "type": "integer", "minimum": 1, "maximum": 180 },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "hints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 8 }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["typescript"] }
      }
    }
  }
}
